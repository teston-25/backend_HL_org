# Server  
PORT=5001  
NODE_ENV=development  
BASE_URL=http://localhost:5001  
CORS_ORIGIN=http://localhost:5173  
  
# Database (PostgreSQL)  
DATABASE_URL=postgresql://user:password@localhost:5432/hl_org_db  
  
# Authentication  
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here_different_from_access  
  
# Chapa Payment Gateway  
CHAPA_SECRET_KEY=your_chapa_secret_key_here  
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_here 
  
# Cloudinary (File Storage)  
CLOUDINARY_CLOUD_NAME=your_cloud_name  
CLOUDINARY_API_KEY=your_api_key  
CLOUDINARY_API_SECRET=your_api_secret  
  
# Email (Nodemailer)  
EMAIL_HOST=smtp.gmail.com  
EMAIL_PORT=587  
EMAIL_USER=your_email@gmail.com  
EMAIL_PASS=your_app_password  
EMAIL_FROM="Hibret Lebego Organization <your_email@gmail.com>"