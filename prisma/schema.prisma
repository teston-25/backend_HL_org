// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password_hash String
  created_at    DateTime @default(now())
}

model Donation {
  id            Int      @id @default(autoincrement())
  amount        Float
  email         String
  first_name    String
  last_name     String
  phone_number  String?
  title         String?
  description   String?
  tx_ref        String   @unique
  status        String   @default("pending") // pending, completed, failed
  ref_id        String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model Contact {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  subject    String
  message    String
  type       String   // general/volunteer/etc
  created_at DateTime @default(now())
}

model News {
  id           Int      @id @default(autoincrement())
  title        String
  slug         String   @unique
  excerpt      String
  content      String
  image_url    String?
  category     String
  published_at DateTime?
  created_at   DateTime @default(now())
}

model Emergency {
  id             Int      @id @default(autoincrement())
  title          String
  description    String
  status         String
  affected_count Int?
  raised_amount  Float?
  created_at     DateTime @default(now())
}

model BeneficiaryStats {
  id                   Int      @id @default(autoincrement())
  total_beneficiaries  Int
  countries_count      Int
  water_projects       Int
  updated_at           DateTime @updatedAt @default(now())
}

model TransparencyFile {
  id         Int      @id @default(autoincrement())
  title      String
  file_url   String
  file_type  String   // annual_report/audit
  year       Int
  created_at DateTime @default(now())
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  deposit_amount Float
  source         String
  reference      String
  created_at     DateTime @default(now())
}